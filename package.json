{
  "name": "n-pos",
  "main": "electron/main.cjs",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "description": "N-POS",
  "author": "Nusasoft",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:start": "electron . --no-sandbox",
    "electron:dev": "cross-env NODE_ENV=development electron . --no-sandbox",
    "preelectron:build": "node scripts/remove-console.cjs",
    "electron:build": "cross-env NODE_ENV=production vite build && electron-builder",
    "generate-cert": "node generate-cert.cjs",
    "setup-code-signing": "node setup-code-signing.cjs",
    "generate-openssl": "node generate-openssl-cert.cjs",
    "rebuild-native": "npx @electron/rebuild -f -w serialport",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . --ignore-pattern .history",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.1.3",
    "exceljs": "^3.4.0",
    "file-saver": "^2.0.5",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.574.0",
    "node-forge": "^1.4.0",
    "p-queue": "^9.1.1",
    "qz-tray": "^2.2.5",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "react-toastify": "^11.0.5",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "babel-jest": "^30.2.0",
    "cross-env": "^7.0.3",
    "electron": "^39.8.2",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.nusasoft.app",
    "productName": "N-POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "certs/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "N-POS",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "N-POS"
    }
  },
  "overrides": {
    "qs": "6.14.2",
    "tar": "^7.5.11",
    "form-data": "2.5.4",
    "tough-cookie": "4.1.3",
    "uuid": "^14.0.0",
    "fast-csv": "^4.3.6",
    "tmp": "^0.2.4"
  }
}
